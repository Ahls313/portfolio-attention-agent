"""
Portfolio Attention Score
--------------------------
A volatility-adjusted alerting system for crypto portfolios.

Most "portfolio alert" tools use a flat threshold (e.g. "alert me if a coin
moves more than 2%"). That's noisy: a coin that normally swings 8% a day
moving 3% is nothing, while a coin that normally moves 0.4% a day moving 3%
is a real signal. This script fixes that by scoring each holding's move
relative to its OWN historical volatility, not a fixed number.

It combines four signals into one 0-100 "Attention Score" per holding:
  1. Volatility-adjusted deviation (is this move unusual for THIS asset?),
     using a recency-weighted baseline so the last few days matter more
     than day 30.
  2. Market correlation (is this move isolated, or is the whole market doing it?)
  3. Volume confirmation (is unusual volume backing the price move, or is
     it a thin-book flicker?)
  4. News correlation confidence (is there an actual headline that explains it?)

The score also supports a rolling history per symbol, so a coin that's been
climbing in attention for 3 straight days surfaces differently than a coin
that spiked once and settled back down.

Data sources:
  - Price history: Binance public klines endpoint (no auth needed)
  - Volume: Binance public klines / 24hr ticker (no auth needed)
  - Holdings: user-supplied list (kept local, never requires API keys/secrets)
  - News: headline list passed in (from Binance MCP news tool or manual input)
"""

import math
from dataclasses import dataclass, field
from typing import Optional


@dataclass
class Holding:
    symbol: str          # e.g. "BTC"
    amount: float
    today_pct_change: float          # e.g. -4.2 for -4.2%
    historical_daily_moves: list      # oldest -> newest, e.g. last 30 days
    today_volume: Optional[float] = None        # today's traded volume (base or quote units)
    avg_daily_volume: Optional[float] = None    # baseline average daily volume


@dataclass
class NewsItem:
    headline: str
    related_symbols: list             # which coins this headline plausibly affects


def _decay_weights(n: int, half_life_days: float = 7.0) -> list:
    """
    Exponential decay weights for n data points ordered oldest -> newest.
    The most recent point gets weight 1.0; older points decay by half
    every `half_life_days`. This makes the volatility baseline reflect
    current market regime rather than treating day 1 and day 30 the same.
    """
    decay = math.log(2) / half_life_days
    # index n-1 is most recent -> exponent 0; index 0 is oldest -> largest exponent
    return [math.exp(-decay * (n - 1 - i)) for i in range(n)]


def volatility_adjusted_deviation(holding: Holding) -> float:
    """
    Returns a z-score: how many standard deviations today's move is
    from this asset's own RECENCY-WEIGHTED historical daily average move.
    A z-score of 0.5 = boring/normal. A z-score of 2.5+ = unusual.

    Recent days are weighted more heavily than older ones (7-day half-life),
    so a baseline computed during a calm month doesn't understate what's
    "normal" once volatility has already picked up recently, and vice versa.
    """
    moves = holding.historical_daily_moves
    n = len(moves)
    if n < 5:
        return 0.0  # not enough history to judge, don't overreact

    weights = _decay_weights(n)
    total_weight = sum(weights)

    weighted_mean = sum(w * m for w, m in zip(weights, moves)) / total_weight
    weighted_variance = sum(
        w * (m - weighted_mean) ** 2 for w, m in zip(weights, moves)
    ) / total_weight
    std_dev = math.sqrt(weighted_variance)

    if std_dev == 0:
        return 0.0

    z_score = abs(holding.today_pct_change - weighted_mean) / std_dev
    return round(z_score, 2)


def market_isolation_score(holding: Holding, market_avg_move_pct: float) -> float:
    """
    Returns 0-1: how isolated this move is from the broader market.
    0 = perfectly tracks the market (not asset-specific)
    1 = completely isolated (this coin is doing its own thing)
    """
    if market_avg_move_pct == 0:
        divergence = abs(holding.today_pct_change)
    else:
        divergence = abs(holding.today_pct_change - market_avg_move_pct)

    # Normalize: treat a 5%+ divergence from market as fully isolated
    return round(min(divergence / 5.0, 1.0), 2)


def volume_confirmation_score(holding: Holding) -> float:
    """
    Returns 0-1: does trading volume back up the price move, or is this
    a thin-book flicker that shouldn't be trusted?

    A big % move on normal (or below-normal) volume is often noise from a
    low-liquidity moment; the same move on a volume spike is more likely
    a real, broad-based reaction. Returns 0.0 (neutral, not penalized) when
    volume data isn't available, since it's an optional signal.
    """
    if not holding.today_volume or not holding.avg_daily_volume:
        return 0.0
    if holding.avg_daily_volume == 0:
        return 0.0

    volume_ratio = holding.today_volume / holding.avg_daily_volume

    if volume_ratio <= 1.0:
        return 0.0        # at or below normal volume, no confirmation
    # 1x -> 0.0, 2x -> 0.5, 3x+ -> 1.0 (capped)
    return round(min((volume_ratio - 1.0) / 2.0, 1.0), 2)


def news_confidence_score(symbol: str, news_items: list) -> float:
    """
    Returns 0-1: how directly relevant available news is to this holding.
    This is intentionally conservative, no news match = 0, not a guess.
    """
    matches = [n for n in news_items if symbol in n.related_symbols]
    if not matches:
        return 0.0
    # More directly relevant headlines = higher confidence, capped at 1.0
    return round(min(len(matches) * 0.4, 1.0), 2)


def attention_score(holding: Holding, market_avg_move_pct: float, news_items: list) -> dict:
    """
    Combines the three signals into a single 0-100 Attention Score
    and a human-readable verdict.
    """
    z = volatility_adjusted_deviation(holding)
    isolation = market_isolation_score(holding, market_avg_move_pct)
    volume_conf = volume_confirmation_score(holding)
    news_conf = news_confidence_score(holding.symbol, news_items)

    # Weighting: unusual-for-this-asset move matters most, isolation from
    # market matters second, volume confirmation adds/removes confidence,
    # news confidence adjusts framing on top.
    z_component = min(z / 3.0, 1.0) * 50       # cap z=3 as "max unusual"
    isolation_component = isolation * 25
    volume_component = volume_conf * 15
    news_component = news_conf * 10

    score = round(z_component + isolation_component + volume_component + news_component, 1)

    if score >= 65:
        verdict = "worth checking in"
    elif score >= 35:
        verdict = "mild, keep an eye"
    else:
        verdict = "nothing to see here"

    explanation = _build_explanation(holding, z, isolation, volume_conf, news_conf, news_items)

    return {
        "symbol": holding.symbol,
        "score": score,
        "verdict": verdict,
        "z_score": z,
        "isolation": isolation,
        "volume_confirmation": volume_conf,
        "news_confidence": news_conf,
        "explanation": explanation,
    }


def _build_explanation(holding, z, isolation, volume_conf, news_conf, news_items) -> str:
    parts = []

    if z >= 2.5:
        parts.append(f"{holding.symbol} moved {holding.today_pct_change:+.1f}%, "
                      f"which is highly unusual for this asset (z={z}).")
    elif z >= 1.2:
        parts.append(f"{holding.symbol} moved {holding.today_pct_change:+.1f}%, "
                      f"somewhat above its normal daily range (z={z}).")
    else:
        parts.append(f"{holding.symbol} moved {holding.today_pct_change:+.1f}%, "
                      f"within its normal range for this asset.")

    if isolation >= 0.7:
        parts.append("This move is isolated to this asset, not the broader market.")
    elif isolation <= 0.3:
        parts.append("This tracks the broader market move, likely not asset-specific.")

    if volume_conf >= 0.5:
        parts.append("Volume is well above normal, backing up the move as likely real.")
    elif holding.today_volume and holding.avg_daily_volume and volume_conf == 0.0:
        parts.append("Volume is at/below normal — worth treating the move with some caution.")

    if news_conf > 0:
        matched = [n.headline for n in news_items if holding.symbol in n.related_symbols]
        parts.append(f"Possibly explained by: {matched[0]}")
    else:
        parts.append("No clear news match found for this move.")

    return " ".join(parts)


def run_portfolio_scan(holdings: list, market_avg_move_pct: float, news_items: list):
    results = [attention_score(h, market_avg_move_pct, news_items) for h in holdings]
    results.sort(key=lambda r: r["score"], reverse=True)
    return results


def score_trend(score_history: list) -> dict:
    """
    Given a list of past Attention Scores for ONE symbol, ordered oldest
    to newest (e.g. [41.2, 48.0, 63.5] for the last 3 days), returns a
    trend read. A coin climbing steadily in attention over multiple days
    is a different (and often more important) story than a single-day
    spike that a snapshot alone can't tell you.
    """
    if len(score_history) < 2:
        return {"direction": "insufficient history", "delta": 0.0, "streak": 0}

    delta = round(score_history[-1] - score_history[0], 1)

    streak = 1
    for i in range(len(score_history) - 1, 0, -1):
        if score_history[i] > score_history[i - 1]:
            streak += 1
        else:
            break
    else:
        streak = len(score_history)

    if streak >= 3 and delta > 5:
        direction = f"climbing for {streak} days straight"
    elif delta > 10:
        direction = "rising sharply"
    elif delta < -10:
        direction = "cooling off"
    else:
        direction = "stable"

    return {"direction": direction, "delta": delta, "streak": streak}


