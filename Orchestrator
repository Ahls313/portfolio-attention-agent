"""
Portfolio Attention Scanner — Orchestrator
--------------------------------------------
Ties the full pipeline together: live Binance data -> statistical scoring ->
news correlation -> (optional) trade attempt. This is the Track B piece:
an agent connected to Binance via MCP, making real decisions from real data.

WHY THIS ISN'T A STANDALONE "CALL THE BINANCE API" SCRIPT:
Binance's MCP server is what exposes market data and trading to an AI agent
(Claude, ChatGPT, etc.) running inside an MCP-enabled client — Claude Code,
Claude Desktop, or Claude.ai with the Binance connector attached. A bare
Python script has no MCP session and no API credentials of its own, and
shouldn't be given any (hardcoding exchange keys in a hackathon repo is a
real security mistake). So the *tool calls* below are made by the agent at
runtime, not by this file in isolation.

This file defines what those calls need to look like (`MCPBridge`), and this
script calls them through that interface. Two ways to run it:

  1. LIVE, via an MCP-enabled agent (e.g. Claude Code with Binance MCP
     connected): the agent implements MCPBridge by calling the real
     Binance Mcp tools (spot.ticker24hr, spot.klines, spot.newOrder) and
     passes that implementation into run_pipeline().

  2. RECORDED / DEMO mode (default, no agent needed): uses a snapshot of
     real data pulled live via Binance MCP on Sept 2 2026, so the pipeline
     is fully runnable and inspectable without any live connection.
     `python3 orchestrator.py` runs this mode.

Both modes exercise the exact same pipeline code — the only thing that
changes is where the data comes from.
"""

from dataclasses import dataclass
from typing import Protocol, Optional

from attention_score import Holding, NewsItem, run_portfolio_scan
from dashboard import render_dashboard


# ---------------------------------------------------------------------------
# The MCP interface. An agent connected to Binance MCP implements this by
# calling the real Binance Mcp tools directly (spot.ticker24hr, spot.klines,
# spot.newOrder) and wraps the results in these return shapes.
# ---------------------------------------------------------------------------

class MCPBridge(Protocol):
    def get_ticker_24hr(self, symbol: str) -> dict:
        """Returns Binance spot.ticker24hr response for `symbol`."""
        ...

    def get_daily_klines(self, symbol: str, limit: int = 31) -> list:
        """Returns Binance spot.klines response (1d interval) for `symbol`."""
        ...

    def place_order(self, symbol: str, side: str, quote_order_qty: float) -> dict:
        """
        Attempts a real market order via Binance spot.newOrder.
        Returns either the fill result or a structured error (e.g. the
        exchange's NOTIONAL filter rejection for too-small an order).
        """
        ...


def klines_to_daily_moves(klines: list) -> list:
    """Convert raw kline candles into daily % close-to-close moves."""
    closes = [float(k[4]) for k in klines]
    return [
        (closes[i] - closes[i - 1]) / closes[i - 1] * 100
        for i in range(1, len(closes))
    ]


