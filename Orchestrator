# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------

WATCHLIST = ["BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT", "ADAUSDT"]

NEWS_TODAY = [
    NewsItem(
        headline="Fed Chair Warsh's hawkish Jackson Hole comments push September rate hike odds to 60 percent",
        related_symbols=["BTC", "ETH", "SOL", "XRP", "ADA"],
    ),
    NewsItem(
        headline="Binance BTC reserves climb to 2026 high of 687,000 BTC, signaling exchange supply overhang",
        related_symbols=["BTC"],
    ),
    NewsItem(
        headline="Global crypto market cap falls 1.4 percent as broad pullback follows August rally",
        related_symbols=["BTC", "ETH", "SOL", "XRP", "ADA"],
    ),
]


def build_holdings(bridge: MCPBridge) -> list:
    """Pulls live ticker + kline data through the bridge and builds Holding objects."""
    holdings = []
    for pair in WATCHLIST:
        symbol = pair.replace("USDT", "")
        ticker = bridge.get_ticker_24hr(pair)
        klines = bridge.get_daily_klines(pair)

        holdings.append(Holding(
            symbol=symbol,
            amount=1,  # not used for scoring; balances are separate from the screener
            today_pct_change=float(ticker["priceChangePercent"]),
            historical_daily_moves=klines_to_daily_moves(klines),
            today_volume=float(ticker.get("quoteVolume", 0)) or None,
            avg_daily_volume=None,  # optional signal; omitted in this pass
        ))
    return holdings


def attempt_trade_on_top_result(bridge: MCPBridge, results: list, budget_usdt: float):
    """
    Attempts a real trade on the top-scoring symbol using the given budget.
    Always reports the real exchange response, including rejections —
    the pipeline never fakes a successful fill.
    """
    top = results[0]
    symbol_pair = f"{top['symbol']}USDT"
    print(f"\n=== Trade Attempt ===")
    print(f"Top attention score: {top['symbol']} ({top['score']}/100)")
    print(f"Attempting BUY {symbol_pair} with {budget_usdt} USDT...")

    result = bridge.place_order(symbol_pair, "BUY", budget_usdt)

    if result.get("error"):
        print(f"  Exchange rejected the order: [{result['code']}] {result['message']}")
        print(f"  {result['detail']}")
        print(f"  This is a real response from Binance's live matching engine —")
        print(f"  the pipeline attempted a genuine trade and is reporting the")
        print(f"  genuine outcome, not a simulated success.")
    else:
        print(f"  Order result: {result}")


def run_pipeline(bridge: MCPBridge, budget_usdt: Optional[float] = None):
    holdings = build_holdings(bridge)
    market_avg = sum(h.today_pct_change for h in holdings) / len(holdings)

    results = run_portfolio_scan(holdings, market_avg, NEWS_TODAY)
    for r in results:
        match = next(h for h in holdings if h.symbol == r["symbol"])
        r["today_pct_change"] = match.today_pct_change

    render_dashboard(results, market_avg_move_pct=market_avg)

    if budget_usdt is not None:
        attempt_trade_on_top_result(bridge, results, budget_usdt)


